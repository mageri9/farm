ANYMODEL_API_KEY=
# PRIMARY_MODEL overrides the legacy ANYMODEL_MODEL setting when both are set.
PRIMARY_MODEL=ag/gemini-3.7-flash-medium
FALLBACK_MODEL=ag/claude-sonnet-4-6
# Per-attempt TTS timeout; one retry loop, then one Dmitry -> Svetlana fallback.
SHORTS_TTS_TIMEOUT=30
SHORTS_RETRY_ATTEMPTS=3
SHORTS_RETRY_DELAY=3
